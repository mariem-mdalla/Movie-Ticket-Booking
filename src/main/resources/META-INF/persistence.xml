<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
    <persistence-unit name="MovieTicketBookingDevPU" transaction-type="JTA">
        <jta-data-source>java:jboss/datasources/ExampleDS</jta-data-source>

        <class>com.movieticket.entity.User</class>
        <class>com.movieticket.entity.Movie</class>
        <class>com.movieticket.entity.Auditorium</class>
        <class>com.movieticket.entity.Seat</class>
        <class>com.movieticket.entity.Showtime</class>
        <class>com.movieticket.entity.Reservation</class>
        <class>com.movieticket.entity.ReservationSeat</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="create"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
